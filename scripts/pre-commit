#!/bin/bash
# Pre-commit hook: block sensitive files, then check for vulnerabilities.
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
set -euo pipefail

export PATH="$HOME/.local/go/bin:$HOME/go/bin:/usr/local/go/bin:/usr/local/bin:$PATH"

# --- Guard: block sensitive files from being committed ---
BLOCKED_PATTERNS=(
  'PLAN.md'
  'NOTES.md'
  'DRAFT.md'
  'PRIVATE.md'
  'INTERNAL.md'
  '.env'
  '.env.'
  '*.pem'
  '*.key'
  '*.p12'
  '*.pfx'
  'credentials.json'
  '*.htpasswd'
  '.DS_Store'
  'Thumbs.db'
)

staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
for file in $staged; do
  basename=$(basename "$file")
  for pattern in "${BLOCKED_PATTERNS[@]}"; do
    if [[ "$basename" == $pattern ]]; then
      echo "BLOCKED: '$file' matches sensitive pattern '$pattern'"
      echo "If this is a false positive, use: git add -f <file> (not recommended for secrets)"
      exit 1
    fi
  done
  # Check file content for private keys
  if git show ":$file" 2>/dev/null | grep -qE 'BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY'; then
    echo "BLOCKED: '$file' contains a private key"
    exit 1
  fi
done

echo "==> Sensitive file guard: passed"

echo "==> Sensitive content scan"
bash scripts/check-sensitive-content

# --- gofmt (check-only; the harness and CI run the same script) ---
echo "==> gofmt check"
bash scripts/check-gofmt

# A commit contains the index, not the working tree. scripts/check-staged-gofmt
# validates the staged blob of every Go path whose index content differs from
# HEAD, read from the index itself, so a staged blob cannot be hidden behind the
# skip-worktree or assume-unchanged bit (both invisible to git diff) and every
# change type is covered. It refuses a gitlink at a Go path and a symlink whose
# staged target differs from the working tree.
echo "==> gofmt check (staged blobs)"
bash scripts/check-staged-gofmt

# --- go vet ---
echo "==> go vet ./..."
go vet ./... || { echo "FAIL: go vet found issues. Fix them before committing."; exit 1; }

echo "==> govulncheck ./..."
if command -v govulncheck &>/dev/null; then
    output=$(govulncheck -C 0 ./... 2>&1) || true
    if echo "$output" | grep -q "Your code is affected by"; then
        echo "FAIL: govulncheck found vulnerabilities. Upgrade affected packages before committing."
        echo "$output"
        exit 1
    fi
    echo "govulncheck: clean"
else
    echo "WARNING: govulncheck not installed. Run: go install golang.org/x/vuln/cmd/govulncheck@latest"
fi

# go mod tidy -diff reads the files on disk, so it cannot see a stale staged
# module file. The index blob is compared against the working file directly
# instead of with `git diff`, because a module file carrying the skip-worktree or
# assume-unchanged bit is invisible to `git diff` while its staged blob still
# lands in the commit. Paths are anchored to the repository root, so a nested
# module elsewhere in the tree cannot trip this guard.
echo "==> go.mod/go.sum staged state"
for name in go.mod go.sum; do
    idx_blob="$(git ls-files --cached -s -z -- ":(top)$name" | tr '\0' '\n' | head -n 1 | awk '{ print $2 }')"
    if [ -z "$idx_blob" ]; then
        continue
    fi
    if [ ! -f "$name" ]; then
        echo "FAIL: $name is staged but missing from the working tree. Restore it or stage its deletion."
        exit 1
    fi
    wt_blob="$(git hash-object -- "$name")"
    if [ "$idx_blob" != "$wt_blob" ]; then
        echo "FAIL: staged $name differs from the working tree. Run 'go mod tidy', then 'git add $name', so the commit records the file that was checked."
        exit 1
    fi
done

echo "==> go mod tidy (check-only, never rewrites)"
if ! go mod tidy -diff; then
    echo "FAIL: go.mod/go.sum are not tidy. Run 'go mod tidy' and stage the result."
    exit 1
fi

echo "All checks passed."
