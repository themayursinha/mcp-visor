#!/usr/bin/env bash
# Check that every Go file in the working tree is gofmt-clean.
#
# Check-only by design: this script never rewrites a file. Verification must not
# mutate the tree it verifies, because cmd/visor-workflow binds task evidence to
# a workspace snapshot digest and rejects a later mismatch. `make fmt` stays the
# developer command for fixing drift.
#
# Used by CI (.github/workflows/ci.yml), the harness (harness/check.sh) and the
# pre-commit hook, so one rule applies everywhere.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

export PATH="$HOME/.local/go/bin:$HOME/go/bin:/usr/local/go/bin:${PATH:-}"

if ! command -v gofmt >/dev/null 2>&1; then
  echo "error: gofmt not found on PATH" >&2
  exit 1
fi

# Tracked plus untracked-but-not-ignored Go files. Using git's file list rather
# than `gofmt -l .` keeps ignored trees such as .worktrees/ out of the check.
mapfile -t files < <(git ls-files -co --exclude-standard -- '*.go')

if [ "${#files[@]}" -eq 0 ]; then
  echo "error: no Go files found; run this from a repository checkout" >&2
  exit 1
fi

# A gofmt error (for example a Go file that does not parse) makes this
# substitution fail, and `set -e` exits non-zero: fail closed, never rewrite.
unformatted="$(gofmt -l "${files[@]}")"

if [ -n "$unformatted" ]; then
  echo "FAIL: these files are not gofmt-clean:" >&2
  echo "$unformatted" >&2
  echo >&2
  echo "Run 'make fmt' and commit the result." >&2
  exit 1
fi

echo "gofmt: clean (${#files[@]} files)"
